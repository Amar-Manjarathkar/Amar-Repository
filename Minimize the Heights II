import java.util.*;

class Solution {
    public int getMinDiff(int[] arr, int k) {
        int n = arr.length;
        Arrays.sort(arr);

        // Initial difference (without modification)
        int ans = arr[n - 1] - arr[0];

        // Smallest and largest after first modification
        int small = arr[0] + k;
        int big = arr[n - 1] - k;

        for (int i = 0; i < n - 1; i++) {
            int minVal = Math.min(small, arr[i + 1] - k);
            int maxVal = Math.max(big, arr[i] + k);

            if (minVal < 0) continue;  // skip invalid case (no negative allowed)

            ans = Math.min(ans, maxVal - minVal);
        }

        return ans;
    }
}
